---
interface Props {
	title: string;
    description?: string;
}

const { title, description = "Calculadora Financiera: Descubre si te conviene Amortizar tu Hipoteca o Invertir tus ahorros. Decisión financiera inteligente en segundos." } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Calculadora Financiera Gratuita 2026. Descubre si te interesa más Amortizar Hipoteca anticipadamente o Invertir tus ahorros. Simulador matemático imparcial." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Calculadora Intereses: Simulador Hipoteca y Rentabilidad 2026</title>

        <!-- SEO / Social -->
        <meta property="og:title" content="Calculadora Intereses: ¿Amortizar o Invertir?" />
        <meta property="og:description" content="Simula gratis tus intereses. Descubre cuánto ahorras amortizando hipoteca vs invirtiendo en cuentas remuneradas." />
        <meta property="og:type" content="website" />
        <meta name="robots" content="index, follow" />
        
        <!-- Fonts: Outfit (Modern Geometric) + Inter (Legible) -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@500;700;800&display=swap" rel="stylesheet">
        
        <!-- Google AdSense -->
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4709503721463415" crossorigin="anonymous"></script>
	</head>
	<body class="bg-slate-50 text-slate-900 font-sans antialiased selection:bg-blue-600 selection:text-white relative overflow-x-hidden">
        <!-- Tech Background Grid -->
        <div class="fixed inset-0 z-0 pointer-events-none opacity-[0.03]" style="background-image: radial-gradient(#1e293b 1px, transparent 1px); background-size: 24px 24px;"></div>
        
		<nav class="border-b border-slate-200/60 bg-white/80 backdrop-blur-md sticky top-0 z-50 transition-all duration-300">
            <div class="container mx-auto px-6 py-4 flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-gradient-to-br from-blue-700 to-blue-900 rounded-lg flex items-center justify-center text-white font-heavy font-extrabold text-lg shadow-lg shadow-blue-900/20">
                        %
                    </div>
                    <div class="font-heading font-bold text-xl tracking-tight text-slate-900">
                        CALCULADORA<span class="text-blue-600 font-medium">INTERESES</span>
                    </div>
                </div>
                <div class="text-xs font-semibold text-slate-600 hidden md:flex items-center gap-4 uppercase tracking-wider font-sans">
                    <span class="flex items-center gap-1.5 px-3 py-1 rounded-md bg-slate-100 border border-slate-200 text-emerald-700">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        Datos Oficiales 2026
                    </span>
                    <span>Simulador Matemático</span>
                </div>
            </div>
        </nav>
        
        <div class="relative z-10 font-sans">
            <slot />
        </div>
        
        <footer class="mt-0 py-16 bg-slate-950 text-slate-400 text-center text-sm border-t border-slate-800 relative overflow-hidden">
            <!-- Footer Glow -->
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-blue-900/20 rounded-full blur-[120px] pointer-events-none"></div>

            <div class="container mx-auto px-6 max-w-4xl relative z-10">
                <div class="mb-10">
                    <div class="inline-flex items-center gap-2 mb-6 opacity-80 hover:opacity-100 transition-all duration-500">
                         <div class="w-6 h-6 bg-gradient-to-br from-blue-700 to-blue-900 rounded flex items-center justify-center text-white font-heavy font-extrabold text-xs shadow-lg">
                            %
                        </div>
                         <span class="font-heading font-bold text-xl text-white tracking-widest">
                            CALCULADORA<span class="text-blue-500 font-medium">INTERESES</span>
                         </span>
                    </div>
                    <p class="leading-relaxed text-xs opacity-70 max-w-2xl mx-auto font-light">
                        Los cálculos presentados son simulaciones matemáticas basadas en hipótesis estándar de mercado y fiscalidad española (IRPF 19-26%). 
                        No garantizamos rentabilidades futuras. Los enlaces a entidades colaboradoras nos permiten mantener este servicio gratuito mediante afiliación transparente.
                    </p>
                </div>
                <div class="flex justify-center gap-8 text-xs font-semibold uppercase tracking-widest opacity-60">
                    <a href="/legal" class="hover:text-blue-400 transition-colors">Aviso Legal</a>
                    <a href="/legal" class="hover:text-blue-400 transition-colors">Privacidad</a>
                    <a href="mailto:hola@amortizaroinvertir.es" class="hover:text-blue-400 transition-colors">Contacto</a>
                </div>
                <div class="mt-8 text-[10px] opacity-30 font-mono">
                    System Version 2.4.0 • Updated Jan 2026
                </div>
            </div>
        </footer>
	</body>
</html>

<style is:global>
    html {
        font-size: 95%; /* Reduces overall scale by ~5% (User asked for ~10% visual reduction) */
    }
    @media (min-width: 1024px) {
        html {
            font-size: 92%; /* Slightly smaller on desktop to fit more */
        }
    }

    .font-sans { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Outfit', sans-serif; }
    
    /* Sharp Inputs Override */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
</style>
